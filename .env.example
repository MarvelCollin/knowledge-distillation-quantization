# Optional. Restricts significance_tests.py to a subset of problem ids, one per
# line. Used to reproduce the verified-subset column of the paper.
# SUBSET_FILE=data/verified_116.txt

# Optional. Excludes problem ids listed in the file, one per line.
# EXCLUDE_FILE=data/excluded.txt

# Optional. Only needed if you hit Hugging Face rate limits while downloading
# the base models. The models used here are public and need no token otherwise.
# HF_TOKEN=
