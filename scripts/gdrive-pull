#!/usr/bin/env bash
# Fast RESTORE from the Drive backup, with multi-threaded downloads.
# Usage: gdrive-pull <subpath-under-kd-backup> [dest]
#   gdrive-pull outputs_gptq                 -> ./outputs_gptq
#   gdrive-pull outputs_gptq /data/restore   -> /data/restore
# Download is multi-stream, so large files come back far faster than they uploaded.
export HOME=/home/hendrik-n PATH=/home/hendrik-n/.local/bin:$PATH
sub="${1:?usage: gdrive-pull <subpath under kd-backup> [dest]}"
dest="${2:-$sub}"
exec rclone copy "gdrive:kd-backup/${sub}" "${dest}" \
  --transfers 8 --checkers 16 \
  --multi-thread-streams 4 --multi-thread-cutoff 100M \
  --drive-chunk-size 128M --buffer-size 64M \
  --log-level NOTICE -P
