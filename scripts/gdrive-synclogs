#!/usr/bin/env bash
# Push training logs to Drive. Run after a training run (or from cron) to keep
# gdrive:kd-backup/logs up to date. Only uploads new/changed files.
export HOME=/home/hendrik-n PATH=/home/hendrik-n/.local/bin:$PATH
cd /home/kolin/knowledge-distillation-quantization || exit 1
for d in logs sparse_logs; do
  [ -d "$d" ] && rclone copy "$d" "gdrive:kd-backup/${d}" \
    --transfers 8 --checkers 16 --log-level NOTICE -P
done
echo "training logs synced -> gdrive:kd-backup/logs"
